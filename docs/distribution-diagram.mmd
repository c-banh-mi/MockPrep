flowchart TB
    client["<b>Client</b><br/>Next.js frontend / curl<br/>Authorization: Bearer JWT"]

    subgraph scheduler["MockPrep API (Spring Boot)"]
        direction TB
        api["CustomerController / BookingAgent tools<br/>book, cancel"]
        tx["SlotBooker / AppointmentService / ReminderAgent<br/>ONE transaction: change + outbox row"]
        relay["NotificationRelay<br/>AFTER_COMMIT trigger + 5 s poll<br/>rows in id order, per-appointment ordering"]
        sender["NotificationSender<br/>3 attempts, 200 ms / 400 ms backoff<br/>then next_attempt_at +30 s, FAILED after 10"]
        gateway["NotificationGateway interface<br/>RestNotificationGateway<br/>timeouts: connect 1 s, read 2 s"]
        api --> tx
        relay --> sender --> gateway
    end

    db[("PostgreSQL<br/>appointments, availability_slots, ...<br/>notification_outbox")]

    subgraph external["Notification Service (mock, separate system)"]
        auth["MockNotifyApiKeyFilter<br/>401 without X-Api-Key"]
        mock["MockNotificationController<br/>POST /mock-notify/api/notifications<br/>stores each idempotencyKey once"]
        auth --> mock
    end

    client -- "HTTP/JSON<br/>201 right after commit" --> api
    tx -- "JDBC: booking + outbox row commit together" --> db
    db -- "PENDING rows, oldest first" --> relay
    sender -- "SENT / retry later / FAILED" --> db
    gateway == "HTTP POST + X-Api-Key + Idempotency-Key<br/>NotificationRequest DTO:<br/>idempotencyKey, recipient, type,<br/>message, appointmentId" ==> auth

    style external stroke-dasharray: 5 5
