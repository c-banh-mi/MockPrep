# Copy to .env (gitignored) and fill in. docker compose and `mvn spring-boot:run` (after export) read it.
DB_USERNAME=scheduler
DB_PASSWORD=change-me

# JWT signing key, base64, at least 32 bytes:  openssl rand -base64 32
# Blank = a random key on every start (everyone is logged out after a restart).
JWT_SECRET=

# Shared key between the scheduler and the notification service (sent as X-Api-Key).
# Blank = random per start. Set it to call the mock service's /mock-notify endpoints with curl.
NOTIFICATION_API_KEY=

# Milestone 4 AI: a free Gemini API key from https://aistudio.google.com/apikey
# Only the API key is used (Gemini Developer API), never a Google Cloud project-id/location.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
